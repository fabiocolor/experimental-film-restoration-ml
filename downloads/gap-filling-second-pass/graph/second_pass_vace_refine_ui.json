   "inputs": [],
   "outputs": [],
   "title": "Hardware",
   "properties": {},
   "widgets_values": [
    "Wan VACE 14B in fp16 wants an NVIDIA card with 24 GB of VRAM or more and about 32 GB of model files; an 81-frame window takes some minutes. The graph opens in Comfy Cloud for reading; running it there is a paid job."
   ],
   "color": "#3b3b2e",
   "bgcolor": "#5a5a3a"
  },
